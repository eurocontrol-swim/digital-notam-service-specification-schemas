{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://www.eurocontrol.int/swim/dns/1.0/SubscriptionRequest.schema.json",
  "title": "SubscriptionRequest",
  "type": "object",
  "properties": {
    "topicId": {
      "type": "string"
    },
    "eventScenario": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "airportHeliport": {
      "type": "array",
      "items": { "type": "string" }
    },
    "airspace": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["topicId", "eventScenario"],
  "additionalProperties": false
}
