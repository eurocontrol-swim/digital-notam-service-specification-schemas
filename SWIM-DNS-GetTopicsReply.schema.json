{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://www.eurocontrol.int/swim/dns/1.0/GetTopicsReply.schema.json",
  "title": "GetTopicsReply",
  "description": "Payload of a GetTopicsReply message.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "topics": {
      "type": "array",
      "description": "Topics available for subscription.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "topicId": {
            "type": "string",
            "description": "Provider-defined identifier of the topic."
          },
          "description": {
            "type": "string",
            "description": "Human-readable description of the topic."
          }
        },
        "required": [
          "topicId",
          "description"
        ]
      }
    }
  },
  "required": [
    "topics"
  ]
}
