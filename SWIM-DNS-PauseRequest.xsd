<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns="http://www.eurocontrol.int/swim/dns/1.0"
            targetNamespace="http://www.eurocontrol.int/swim/dns/1.0"
            elementFormDefault="qualified">

    <!-- Root element identifies the intent (pause) regardless of endpoint pattern -->
    <xsd:element name="PauseRequest" type="PauseRequestType"/>

    <!-- PauseRequest message payload -->
    <xsd:complexType name="PauseRequestType">
        <xsd:sequence>
            <!-- Empty content: the message name and endpoint together carry the intent -->
        </xsd:sequence>
    </xsd:complexType>

</xsd:schema>
