{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://www.eurocontrol.int/swim/dns/1.0/GetTopicReply.schema.json",
  "title": "GetTopicReply",
  "description": "Payload of a GetTopicReply message.",
  "type": "object",
  "properties": {
    "topicId": {
      "type": "string",
      "description": "Provider-defined identifier of the topic."
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the topic."
    },
    "eventScenario": {
      "type": "array",
      "description": "Event scenarios covered by the topic.",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "required": [
    "topicId",
    "description",
    "eventScenario"
  ],
  "additionalProperties": false
}
