<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns="http://www.eurocontrol.int/swim/dns/1.0"
            targetNamespace="http://www.eurocontrol.int/swim/dns/1.0"
            elementFormDefault="qualified">

    <!-- Root element -->
    <xsd:element name="GetSubscriptionsReply" type="GetSubscriptionsReplyType"/>

    <!-- GetSubscriptionsReply message payload -->
    <xsd:complexType name="GetSubscriptionsReplyType">
        <xsd:sequence>
            <xsd:element name="subscription" type="subscriptionSummaryType" minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence>
    </xsd:complexType>

    <!-- Summary of a single subscription -->
    <xsd:complexType name="subscriptionSummaryType">
        <xsd:sequence>
            <xsd:element name="subscriptionId" type="xsd:string"/>
            <xsd:element name="topicId"        type="xsd:string"/>
            <xsd:element name="address"        type="xsd:string"/>
            <xsd:element name="status"         type="subscriptionStatusType"/>
        </xsd:sequence>
    </xsd:complexType>

    <!-- Subscription status enumeration -->
    <xsd:simpleType name="subscriptionStatusType">
        <xsd:restriction base="xsd:string">
            <xsd:enumeration value="active"/>
            <xsd:enumeration value="paused"/>
        </xsd:restriction>
    </xsd:simpleType>

</xsd:schema>
