{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://www.eurocontrol.int/swim/dns/1.0/GetSubscriptionsReply.schema.json",
  "title": "GetSubscriptionsReply",
  "type": "object",
  "properties": {
    "subscriptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/subscriptionSummary" }
    }
  },
  "required": ["subscriptions"],
  "additionalProperties": false,
  "$defs": {
    "subscriptionSummary": {
      "type": "object",
      "properties": {
        "subscriptionId": { "type": "string" },
        "topicId":        { "type": "string" },
        "address":        { "type": "string" },
        "status":         { "enum": ["active", "paused"] }
      },
      "required": ["subscriptionId", "topicId", "address", "status"],
      "additionalProperties": false
    }
  }
}
