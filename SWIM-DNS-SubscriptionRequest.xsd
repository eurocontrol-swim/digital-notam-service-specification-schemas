<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns="http://www.eurocontrol.int/swim/dns/1.0"
            targetNamespace="http://www.eurocontrol.int/swim/dns/1.0"
            elementFormDefault="qualified">

    <!-- Root element -->
    <xsd:element name="subscriptionRequest" type="subscriptionRequestType"/>

    <!-- SubscriptionRequest message payload -->
    <xsd:complexType name="subscriptionRequestType">
        <xsd:sequence>
            <xsd:element name="topicId"         type="xsd:string"/>
            <xsd:element name="eventScenario"   type="xsd:string" minOccurs="1" maxOccurs="unbounded"/>
            <xsd:element name="airportHeliport" type="xsd:string" minOccurs="0" maxOccurs="unbounded"/>
            <xsd:element name="airspace"        type="xsd:string" minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence>
    </xsd:complexType>

</xsd:schema>
