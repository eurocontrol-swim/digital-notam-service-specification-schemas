{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://www.eurocontrol.int/swim/dns/1.0/GetSubscriptionDetailsReply.schema.json",
  "title": "GetSubscriptionDetailsReply",
  "type": "object",
  "properties": {
    "subscriptionId": { "type": "string" },
    "topicId":        { "type": "string" },
    "address":        { "type": "string" },
    "status":         { "enum": ["active", "paused"] },
    "eventScenario": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "airportHeliport": {
      "type": "array",
      "items": { "type": "string" }
    },
    "airspace": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["subscriptionId", "topicId", "address", "status", "eventScenario"],
  "additionalProperties": false
}
